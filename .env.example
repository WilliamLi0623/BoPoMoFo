# Optional Supabase configuration for authenticated sync. Keep values local;
# this file is a template and must not contain credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Web OAuth client ID (not Android client ID), used for native Android login.
GOOGLE_OAUTH_CLIENT_ID=
# Registered deep-link callback for browser OAuth on other supported platforms.
GOOGLE_OAUTH_REDIRECT_URI=
# Register this callback and provider only for iOS/macOS Apple sign-in.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
